# Copy to .env for local development. Never commit real values.
# The app connects as a role that does NOT own the tables, so row-level security applies.
DATABASE_URL=postgres://onpar_app:onpar_app_dev@localhost:5432/onpar
# Migrations run as the owner role.
DATABASE_OWNER_URL=postgres://onpar_owner:onpar_owner_dev@localhost:5432/onpar
# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET=change-me
# 32 random bytes, base64. Encrypts SA ID numbers. Generate with: openssl rand -base64 32
DATA_KEY=
UPLOAD_DIR=./uploads
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Send the sign-in cookie over HTTPS only (keep true; browsers treat localhost as secure).
COOKIE_SECURE=true
# Proxies trusted for the caller's address: 'loopback' locally, the load balancer's range in production.
TRUST_PROXY=loopback
# File storage: 'local' (UPLOAD_DIR) or 's3'. Files are encrypted by the app with DATA_KEY either way.
STORAGE_DRIVER=local
# S3_BUCKET=onpar-files
# S3_REGION=af-south-1
# S3_KMS_KEY_ID=
